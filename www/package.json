{
  "name": "domoticz-frontend",
  "version": "1.0.0",
  "description": "Domoticz Home Automation Frontend Tests",
  "scripts": {
    "test": "karma start ../test/www/karma.conf.js",
    "test:once": "karma start ../test/www/karma.conf.js --single-run",
    "test:watch": "karma start ../test/www/karma.conf.js --auto-watch",
    "test:coverage": "karma start ../test/www/karma.conf.js --single-run --reporters coverage"
  },
  "devDependencies": {
    "angular": "^1.8.3",
    "angular-mocks": "^1.8.3",
    "jasmine-core": "^4.5.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-requirejs": "^1.1.0",
    "requirejs": "^2.3.6"
  },
  "keywords": [
    "domoticz",
    "home-automation",
    "angularjs",
    "testing"
  ],
  "author": "Domoticz Contributors",
  "license": "GPL-3.0"
}
