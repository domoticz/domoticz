#!/bin/bash
set -euo pipefail

# Domoticz Update Script (BRUTE FORCE VERSION)
# Created by GizMoCuz, 2025, version 2.2
# Usage: ./update_domoticz [--no-backup]

# Changes:
# - Removed "service_exists" checks that were failing.
# - Forces "systemctl stop/start" commands blindly (safer and more reliable).
# - Self-update disabled.

readonly SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly BACKUP_DIR="backups"
readonly MAX_BACKUPS=5
readonly DOWNLOAD_URL="https://www.domoticz.com/download.php"
readonly ARCHIVE_NAME="domoticz_update.tgz"
readonly CHANNEL_KEYWORD="beta"

readonly REQUIRED_PACKAGES=()
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' 

log_info() { echo -e "${GREEN}>>${NC} $*"; }
log_warn() { echo -e "${YELLOW}>>${NC} $*"; }
log_error() { echo -e "${RED}>>${NC} $*" >&2; }
die() { log_error "$*"; exit 1; }

check_dependencies() {
    log_info "Checking package dependencies..."
    local missing_packages=()
    local pkg
    for pkg in "${REQUIRED_PACKAGES[@]}"; do
        if ! dpkg -l | grep -q "^ii  $pkg"; then
            missing_packages+=("$pkg")
        fi
    done
    if [[ ${#missing_packages[@]} -gt 0 ]]; then
        log_info "Installing missing packages: ${missing_packages[*]}"
        sudo apt-get update -qq
        sudo apt-get install -y "${missing_packages[@]}"
    fi
}

validate_environment() {
    log_info "Validating environment..."
    [[ "$SCRIPT_DIR" == "$PWD" ]] || die "Script must be run from Domoticz directory!"
    local required_cmds=(wget tar sudo openssl dpkg uname)
    for cmd in "${required_cmds[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || die "Required command '$cmd' not found!"
    done
    local mach arch openssl_ver
    mach=$(uname -m)
    arch=$(dpkg --print-architecture)
    openssl_ver=$(openssl version | awk '{print $2}' | cut -d. -f1)
    [[ "$mach" == "armv6l" ]] && die "ARMv6 is not supported."
    [[ "$arch" == "armhf" ]] && mach="armv7l"
    [[ "$openssl_ver" -eq 3 ]] || die "OpenSSL version 3 required! (Found version $openssl_ver)"
    export DETECTED_MACH="$mach"
    export DETECTED_OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
    log_info "Environment validation passed (arch: $DETECTED_MACH, OS: $DETECTED_OS)"
}

download_update() {
    log_info "Downloading latest $CHANNEL_KEYWORD version..."
    if ! wget -4 -q --show-progress --progress=bar:force -O "$ARCHIVE_NAME" --no-check-certificate \
        "${DOWNLOAD_URL}?channel=${CHANNEL_KEYWORD}&type=release&system=${DETECTED_OS}&machine=${DETECTED_MACH}"; then
        die "Failed to download Domoticz version!"
    fi
    if ! tar tzf "$ARCHIVE_NAME" >/dev/null 2>&1; then
        rm -f "$ARCHIVE_NAME"
        die "Downloaded archive is corrupted!"
    fi
}

create_backup() {
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="$BACKUP_DIR/domoticz_backup_$timestamp.tar.gz"
    log_info "Creating backup: $backup_file"
    mkdir -p "$BACKUP_DIR"
    # We suppress errors here because if the service didn't stop, tar might complain about changed files.
    # We want it to proceed anyway.
    if ! sudo tar --exclude="$BACKUP_DIR" --warning=no-file-changed -czf "$backup_file" .; then
        log_warn "Backup reported issues (likely file changes), but proceeding."
    fi
    local old_backups
    old_backups=$(find "$BACKUP_DIR" -name "domoticz_backup_*.tar.gz" -type f | sort -r | tail -n +$((MAX_BACKUPS + 1)))
    if [[ -n "$old_backups" ]]; then
        echo "$old_backups" | xargs rm -f
    fi
    log_info "Backup complete."
}

# FORCE STOP - No checks, just do it.
stop_service() {
    log_info "Stopping Domoticz service..."
    
    # Try systemd first
    sudo systemctl stop domoticz || true
    
    # Just in case, try init.d
    if [[ -f /etc/init.d/domoticz.sh ]]; then
        sudo service domoticz.sh stop || true
    fi
    
    # Wait a moment to ensure file locks are released
    sleep 2
}

install_update() {
    log_info "Installing new version..."
    if ! tar xfz "$ARCHIVE_NAME" --checkpoint=.100; then
        die "Failed to extract update archive!"
    fi
    rm -f "$ARCHIVE_NAME"
    log_info "Installation complete."
}

# FORCE START - No checks.
start_service() {
    log_info "Starting Domoticz service..."
    
    if ! sudo systemctl start domoticz; then
         # Fallback
         if [[ -f /etc/init.d/domoticz.sh ]]; then
             sudo service domoticz.sh start
         else
             die "Failed to start service!"
         fi
    fi
    
    sleep 2
    log_info "Service started successfully."
}

main() {
    local skip_backup=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-backup|-nobackup) skip_backup=true; shift ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    
    log_info "Starting Domoticz $CHANNEL_KEYWORD Update (Brute Force Mode)"
    
    validate_environment
    check_dependencies
    
    # NO SELF UPDATE CHECK HERE
    
    download_update
    
    stop_service
    
    if [[ "$skip_backup" == false ]]; then
        create_backup
    else
        log_warn "Skipping backup as requested"
    fi
    
    install_update
    start_service
    
    log_info "Update completed successfully!"
}

main "$@"
